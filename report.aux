\@writefile{toc}{\contentsline {paragraph}{1. I thought the reduced representation was bit-identical under rigid motion.}{8}{section*.10}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{2. I reported roll augmentation as worth $+4.4$ points.}{8}{section*.11}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{3. I argued the roll gauge could be fixed by a $C_4$ argument.}{8}{section*.12}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{4. I reported the residual as falling with scale.}{8}{section*.13}\protected@file@percent }
