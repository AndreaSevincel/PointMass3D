\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Points on the held-out collision-free rate, each measured against the model without that mechanism. The rows are not additive and were never composed. The two degree-of-freedom rows were measured only on the fixed-budget grid, which is why that column exists.}}{6}{table.2}\protected@file@percent }
\newlabel{tab:mechanisms}{{2}{6}{Points on the held-out collision-free rate, each measured against the model without that mechanism. The rows are not additive and were never composed. The two degree-of-freedom rows were measured only on the fixed-budget grid, which is why that column exists}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Held-out collision-free rate against training epochs, $60$ environments.} The constrained backbone reaches any given level two to three times sooner than the unconstrained model in the same frame, and the two converge to within $0.15$ points. Seed-matched over three seeds.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:conv}{{3}{6}{\textbf {Held-out collision-free rate against training epochs, $60$ environments.} The constrained backbone reaches any given level two to three times sooner than the unconstrained model in the same frame, and the two converge to within $0.15$ points. Seed-matched over three seeds}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {V-C}Control: local geometry, and how it scales}{6}{subsection.5.3}\protected@file@percent }
\newlabel{sec:localgeom}{{V-C}{6}{Control: local geometry, and how it scales}{subsection.5.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Local geometry against the query frame. Every cell is a mean over two or three seeds. The two local-geometry columns are the least seed-sensitive measurements in this work, with across-seed standard errors of $0.01$ and $0.10$ against $0.20$ and $0.25$ without. The equivariant row is a seed-matched pair, $51.27$ against $51.12$ on the same three seeds, so the $+0.15$ of Table\nobreakspace  {}\ref {tab:mechanisms} is that difference and not $51.27$ minus the three-seed mean $51.10$ above it.}}{6}{table.3}\protected@file@percent }
\newlabel{tab:twobytwo}{{3}{6}{Local geometry against the query frame. Every cell is a mean over two or three seeds. The two local-geometry columns are the least seed-sensitive measurements in this work, with across-seed standard errors of $0.01$ and $0.10$ against $0.20$ and $0.25$ without. The equivariant row is a seed-matched pair, $51.27$ against $51.12$ on the same three seeds, so the $+0.15$ of Table~\ref {tab:mechanisms} is that difference and not $51.27$ minus the three-seed mean $51.10$ above it}{table.3}{}}
